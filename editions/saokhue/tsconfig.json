{
  // Typechecks the edition against the real core sources (the core's own tsc
  // covers website/src only). Run: npx tsc -p ../editions/saokhue/tsconfig.json
  // from website/, or let packaging/build-saokhue.sh run it.
  "extends": "../../website/tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["."],
  "exclude": ["node_modules", "vitest.config.mts"]
}
